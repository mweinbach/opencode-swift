[
  {
    "fn": "jsonc-parser#modifyAndApply",
    "description": "Surgical comment- and formatting-preserving JSONC edits (modify + applyEdits) verified against real jsonc-parser@3.3.1",
    "cases": [
      {
        "name": "line comment before root object: replace existing key",
        "args": [
          "// Top-level config header\n{\n  \"shell\": \"/bin/bash\",\n  \"username\": \"alice\"\n}\n",
          ["shell"],
          { "value": "/bin/zsh" },
          { "formattingOptions": { "tabSize": 2, "insertSpaces": true } }
        ]
      },
      {
        "name": "line comment after root object: insert new key",
        "args": [
          "{\n  \"username\": \"alice\"\n}\n// trailing comment\n",
          ["shell"],
          { "value": "/bin/zsh" },
          { "formattingOptions": { "tabSize": 2, "insertSpaces": true } }
        ]
      },
      {
        "name": "line comments inside object: replace first key",
        "args": [
          "{\n  // primary shell\n  \"shell\": \"/bin/sh\",\n  // user identity\n  \"username\": \"alice\"\n}\n",
          ["shell"],
          { "value": "/bin/fish" },
          { "formattingOptions": { "tabSize": 2, "insertSpaces": true } }
        ]
      },
      {
        "name": "line comments inside object: replace middle key",
        "args": [
          "{\n  // first\n  \"a\": 1,\n  // middle\n  \"b\": 2,\n  // last\n  \"c\": 3\n}\n",
          ["b"],
          { "value": 42 },
          { "formattingOptions": { "tabSize": 2, "insertSpaces": true } }
        ]
      },
      {
        "name": "line comments inside object: insert new key at end",
        "args": [
          "{\n  // keep me\n  \"a\": 1,\n  // keep me too\n  \"b\": 2\n}\n",
          ["c"],
          { "value": true },
          { "formattingOptions": { "tabSize": 2, "insertSpaces": true } }
        ]
      },
      {
        "name": "line comments inside object: remove first key",
        "args": [
          "{\n  // before first\n  \"a\": 1,\n  // before second\n  \"b\": 2\n}\n",
          ["a"],
          { "remove": true },
          { "formattingOptions": { "tabSize": 2, "insertSpaces": true } }
        ]
      },
      {
        "name": "line comments inside object: remove middle key",
